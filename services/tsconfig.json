{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "types": ["bun"],
    "noEmit": true
  },
  "include": ["packages/**/*.ts", "apps/**/*.ts", "scripts/**/*.ts", "integration/**/*.ts", "test/**/*.ts"],
  "exclude": ["**/node_modules"]
}
